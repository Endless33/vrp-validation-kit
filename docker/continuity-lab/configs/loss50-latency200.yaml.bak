schema_version: "vrp-continuity-lab/scenario-v1"

scenario:
  id: "loss50-latency200"
  title: "50% Packet Loss + 200ms Latency"
  category: "network-impairment"

execution:
  duration_seconds: 60
  infrastructure_ready_timeout_seconds: 30
  subject_ready_timeout_seconds: 20
  completion_grace_seconds: 15

network_impairment:
  proxy: wifi
  toxics:
    - type: latency
      toxicity: 1.0
      attributes:
        latency: 200
        jitter: 0

    - type: limit_data
      toxicity: 1.0
      attributes:
        bytes: 1048576

acceptance:
  contract: "../expected/invariant-contract.json"

limitations:
  - "Packet-loss toxic integration pending."
